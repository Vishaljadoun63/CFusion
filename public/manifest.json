{
  "manifest_version": 3,
  "name": "CFusion - Codeforces Reimagined",
  "version": "1.0.0",
  "description": "Modern Codeforces workspace with Monaco Editor, split-screen coding, custom tests, code library, and cloud execution.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
      "*://codeforces.com/*",
      "*://*.codeforces.com/*",
      "https://cfusion-api.onrender.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "CFusion Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ]
    }
  ]
}
